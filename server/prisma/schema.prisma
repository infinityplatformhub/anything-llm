generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model api_keys {
  id            Int         @id @default(autoincrement())
  name          String?
  secretDigest  Bytes       @unique
  keyPrefix     String
  scopes        String
  workspaceId   Int?
  expiresAt     DateTime?   @db.Timestamptz(3)
  lastUsedAt    DateTime?   @db.Timestamptz(3)
  revokedAt     DateTime?   @db.Timestamptz(3)
  createdBy     Int?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime    @default(now()) @db.Timestamptz(3)
  workspace     workspaces? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([keyPrefix])
  @@index([workspaceId])
}

model workspace_documents {
  id                   Int                   @id @default(autoincrement())
  docId                String                @unique
  filename             String
  docpath              String
  workspaceId          Int
  metadata             String?
  pinned               Boolean?              @default(false)
  watched              Boolean?              @default(false)
  // T-1 (P0-5): canonical document reference — docId stays frozen until the
  // doc-vectors-canonicalize job completes (document_vectors still points at it).
  documentId           Int?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  lastUpdatedAt        DateTime              @default(now()) @db.Timestamptz(3)
  workspace            workspaces            @relation(fields: [workspaceId], references: [id])
  document             documents?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  document_sync_queues document_sync_queues?
}

model invites {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  status        String   @default("pending")
  claimedBy     Int?
  workspaceIds  String?
  // S11a (#80): the address this invite was mailed to, or null for a copy-link
  // invite nobody emailed — which is every invite before S11 and every one an
  // admin creates without typing an address.
  email         String?
  // When it stops being redeemable, or null for never. NO @default, deliberately:
  // a default would retire every invite already in the table the moment the
  // migration ran. `Invite.create` applies 7 days, and only when `email` is set.
  //
  // Redemption checks this inside `Invite.get` — never at the routes, which
  // already carry two byte-identical copies of the status check between them.
  expiresAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  createdBy     Int
  lastUpdatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model system_settings {
  id            Int      @id @default(autoincrement())
  label         String   @unique
  value         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model users {
  id                           Int                           @id @default(autoincrement())
  username                     String?                       @unique
  password                     String
  pfpFilename                  String?
  role                         String                        @default("default")
  suspended                    Int                           @default(0)
  seen_recovery_codes          Boolean?                      @default(false)
  createdAt                    DateTime                      @default(now()) @db.Timestamptz(3)
  lastUpdatedAt                DateTime                      @default(now()) @db.Timestamptz(3)
  dailyMessageLimit            Int?
  bio                          String?                       @default("")
  web_push_subscription_config String?
  workspace_chats              workspace_chats[]
  workspace_users              workspace_users[]
  group_members                group_members[]
  embed_configs                embed_configs[]
  embed_chats                  embed_chats[]
  threads                      workspace_threads[]
  recovery_codes               recovery_codes[]
  password_reset_tokens        password_reset_tokens[]
  workspace_agent_invocations  workspace_agent_invocations[]
  slash_command_presets        slash_command_presets[]
  browser_extension_api_keys   browser_extension_api_keys[]
  temporary_auth_tokens        temporary_auth_tokens[]
  system_prompt_variables      system_prompt_variables[]
  prompt_history               prompt_history[]
  desktop_mobile_devices       desktop_mobile_devices[]
  workspace_parsed_files       workspace_parsed_files[]
  memories                     memories[]
  identity_links               identity_links[]
}

model recovery_codes {
  id        Int      @id @default(autoincrement())
  user_id   Int
  code_hash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model password_reset_tokens {
  id        Int      @id @default(autoincrement())
  user_id   Int
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model document_vectors {
  id            Int      @id @default(autoincrement())
  docId         String
  vectorId      String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model workspaces {
  id                           Int                            @id @default(autoincrement())
  name                         String
  slug                         String                         @unique
  vectorTag                    String?
  createdAt                    DateTime                       @default(now()) @db.Timestamptz(3)
  openAiTemp                   Float?
  openAiHistory                Int                            @default(20)
  lastUpdatedAt                DateTime                       @default(now()) @db.Timestamptz(3)
  // THIS IS THE SYSTEM PROMPT FOR THE WORKSPACE
  openAiPrompt                 String?
  similarityThreshold          Float?                         @default(0.25)
  chatProvider                 String?
  chatModel                    String?
  topN                         Int?                           @default(4)
  chatMode                     String?                        @default("chat")
  pfpFilename                  String?
  agentProvider                String?
  agentModel                   String?
  queryRefusalResponse         String?
  vectorSearchMode             String?                        @default("default")
  router_id                    Int? // No relation to prevent whole table migration (SQLite limitation)
  workspace_users              workspace_users[]
  documents                    workspace_documents[]
  workspace_suggested_messages workspace_suggested_messages[]
  embed_configs                embed_configs[]
  threads                      workspace_threads[]
  workspace_agent_invocations  workspace_agent_invocations[]
  prompt_history               prompt_history[]
  workspace_parsed_files       workspace_parsed_files[]
  memories                     memories[]
  api_keys                     api_keys[]
  grants                       principal_role_grants[]
  // T-1 (P0-5, R1): backfilled from the earliest workspace_users row; null where no
  // membership row exists (reported — those get no owner).
  created_by                   Int?
}

model workspace_threads {
  id                     Int                      @id @default(autoincrement())
  name                   String
  slug                   String                   @unique
  workspace_id           Int
  user_id                Int?
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  lastUpdatedAt          DateTime                 @default(now()) @db.Timestamptz(3)
  workspace              workspaces               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user                   users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace_parsed_files workspace_parsed_files[]

  @@index([workspace_id])
  @@index([user_id])
}

model workspace_suggested_messages {
  id            Int        @id @default(autoincrement())
  workspaceId   Int
  heading       String
  message       String
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime   @default(now()) @db.Timestamptz(3)
  workspace     workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model workspace_chats {
  id              Int      @id @default(autoincrement())
  workspaceId     Int
  prompt          String
  response        String
  include         Boolean  @default(true)
  user_id         Int?
  thread_id       Int? // No relation to prevent whole table migration
  api_session_id  String? // String identifier for only the dev API to partition chats in any mode.
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt   DateTime @default(now()) @db.Timestamptz(3)
  feedbackScore   Boolean?
  memoryProcessed Boolean? @map("memory_processed")
  response_text   String? // V9: response.text as plain text, for trigram search. Raw `response` is a JSON blob whose sources/attachments must not be searchable.
  users           users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id, workspaceId, id(sort: Desc)])
}

model workspace_agent_invocations {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique
  prompt        String // Contains agent invocation to parse + option additional text for seed.
  closed        Boolean    @default(false)
  user_id       Int?
  thread_id     Int? // No relation to prevent whole table migration
  workspace_id  Int
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime   @default(now()) @db.Timestamptz(3)
  user          users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace     workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([uuid])
}

model workspace_users {
  id            Int        @id @default(autoincrement())
  user_id       Int
  workspace_id  Int
  // T-1 (P0-5): workspace-local role (owner/editor/viewer). Backfilled: owner where
  // workspaces.created_by matches, else editor (legacy default members could upload).
  role_id       Int?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime   @default(now()) @db.Timestamptz(3)
  workspaces    workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users         users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roles         roles?     @relation(fields: [role_id], references: [id], onDelete: SetNull)
}

model cache_data {
  id            Int       @id @default(autoincrement())
  name          String
  data          String
  belongsTo     String?
  byId          Int?
  expiresAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime  @default(now()) @db.Timestamptz(3)
}

model embed_configs {
  id                         Int           @id @default(autoincrement())
  uuid                       String        @unique
  enabled                    Boolean       @default(false)
  chat_mode                  String        @default("query")
  allowlist_domains          String?
  allow_model_override       Boolean       @default(false)
  allow_temperature_override Boolean       @default(false)
  allow_prompt_override      Boolean       @default(false)
  max_chats_per_day          Int?
  max_chats_per_session      Int?
  message_limit              Int?          @default(20)
  workspace_id               Int
  createdBy                  Int?
  usersId                    Int?
  createdAt                  DateTime      @default(now()) @db.Timestamptz(3)
  workspace                  workspaces    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  embed_chats                embed_chats[]
  users                      users?        @relation(fields: [usersId], references: [id])
}

model embed_chats {
  id                     Int           @id @default(autoincrement())
  prompt                 String
  response               String
  session_id             String
  include                Boolean       @default(true)
  connection_information String?
  embed_id               Int
  usersId                Int?
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  embed_config           embed_configs @relation(fields: [embed_id], references: [id], onDelete: Cascade)
  users                  users?        @relation(fields: [usersId], references: [id])
}

model event_logs {
  id         Int      @id @default(autoincrement())
  eventId    String?  @unique
  event      String
  metadata   String?
  userId     Int?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([event])
}

model slash_command_presets {
  id            Int      @id @default(autoincrement())
  command       String
  prompt        String
  description   String
  uid           Int      @default(0) // 0 is null user
  userId        Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @default(now()) @db.Timestamptz(3)
  user          users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([uid, command])
}

model document_sync_queues {
  id             Int                        @id @default(autoincrement())
  staleAfterMs   Int                        @default(604800000) // 7 days
  nextSyncAt     DateTime                   @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  lastSyncedAt   DateTime                   @default(now()) @db.Timestamptz(3)
  workspaceDocId Int                        @unique
  workspaceDoc   workspace_documents?       @relation(fields: [workspaceDocId], references: [id], onDelete: Cascade)
  runs           document_sync_executions[]
}

model document_sync_executions {
  id        Int                  @id @default(autoincrement())
  queueId   Int
  status    String               @default("unknown")
  result    String?
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  queue     document_sync_queues @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

// P0-4D(c): provider credentials, encrypted at rest with AES-256-GCM. One row per env
// key; iv and authTag are per-row. Deliberately not EncryptionManager's aes-256-cbc:
// an unauthenticated cipher lets anyone who can write this table alter the plaintext
// without detection.
model credential_store {
  id            Int      @id @default(autoincrement())
  envKey        String   @unique
  ciphertext    Bytes
  iv            Bytes
  authTag       Bytes
  keyVersion    Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// PR-4c: which keys held the wildcard scope when it was retired, so the boot report can
// name them and an operator can narrow each one deliberately. Rows are cleared as they
// are acknowledged; an empty table means the migration's grants have all been reviewed.
model api_key_legacy_wildcard_grants {
  id           Int      @id @default(autoincrement())
  api_key_id   Int      @unique
  keyPrefix    String
  grantedAt    DateTime @default(now()) @db.Timestamptz(3)
  acknowledged Boolean  @default(false)
}

model browser_extension_api_keys {
  id            Int      @id @default(autoincrement())
  secretDigest  Bytes    @unique
  keyPrefix     String
  user_id       Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @updatedAt @db.Timestamptz(3)
  user          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([user_id])
}

model temporary_auth_tokens {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// S1 (#36): an external identity bound to a local user.
//
// `provider + subject` is the identity, NEVER email. Email changes, and an IdP
// that lets someone claim an address would otherwise hand them the account.
model identity_links {
  id          Int       @id @default(autoincrement())
  userId      Int
  provider    String
  subject     String
  email       String
  lastLoginAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  user        users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Account linking is a database constraint, not application logic: two users
  // claiming the same IdP identity must fail at the write.
  @@unique([provider, subject])
  @@index([userId])
}

// S1 (#36): one in-flight login. Rows are consumed, not deleted — a consumed row
// is how a replay is told apart from an expiry. The T-6 retention purge clears
// them at TTL; nothing else writes here.
model identity_login_state {
  state        String    @id
  nonce        String
  provider     String
  redirectUri  String
  codeVerifier String
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

// S2 (#43): assertion IDs already spent.
//
// SAML has no PKCE and no nonce — the bearer assertion IS the credential, so a
// captured response is a working login until it expires. Single use is enforced
// HERE, by the unique constraint, not by a check in the ACS route: a check in
// application code is one code path away from being skipped, and this one has
// to hold under two requests racing.
//
// The T-6 retention purge deletes by expiresAt alone. Unswept, this table grows
// by one row per login attempt forever, including failed and unauthenticated
// ones whose rate an attacker chooses.
model identity_assertion_ids {
  id          Int      @id @default(autoincrement())
  provider    String
  assertionId String
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  // Scoped to the provider: assertion IDs are unique only within an issuer, and
  // a provider-blind constraint would let one tenant's traffic lock out another's.
  @@unique([provider, assertionId])
  @@index([expiresAt])
}

// S2 (#43): one identity provider's configuration.
//
// Public material only — entity ID, endpoints, signing certificates. The SP's
// own private key belongs in CredentialStore (AES-256-GCM, bound to its key
// name); this table is read on every login and sits in every backup, so a secret
// column here is a secret in plaintext at rest.
//
// S3b (#68): the `identity_providers_one_shape` CHECK constraint lives in
// migration 092000 and CANNOT be expressed here — Prisma has no schema syntax
// for a row-level CHECK, so the database enforces an invariant this file does
// not mention. Two consequences, both load-bearing:
//
//   - `entityId` and `ssoUrl` are NOT NULL, and an empty string is how a row
//     says "not a SAML provider". The constraint reads it as absence. Making
//     either optional here inverts every clause of that constraint, and Prisma
//     will let you do it silently.
//   - A row must be ONE complete shape: SAML columns filled with the LDAP ones
//     NULL, or LDAP columns filled with the SAML ones empty. A half-configured
//     row is rejected by the database, not by this schema.
model identity_providers {
  id          String   @id @default(uuid())
  provider    String   @unique
  entityId    String
  ssoUrl      String
  // A LIST, because Entra publishes the next certificate before it signs with
  // it. A single-certificate column forces a flag-day cutover, and every login
  // fails as a bad signature between the IdP rotating and someone noticing.
  certificates String[]
  // Fail closed. Configuration is saved field by field, and a provider that
  // went live at the first save would accept logins against a half-written
  // certificate list.
  enabled     Boolean  @default(false)

  // S3 (#60): LDAP. Nullable, because the SAML columns above are equally
  // irrelevant to a directory — one table holds both shapes, and a provider
  // fills in the half that applies to it.
  //
  // No bind password here, by design: unlike SAML's certificates (public
  // material) it is a real secret, and this table is read on every login and
  // sits in every backup. It goes to CredentialStore, AES-256-GCM, bound to its
  // key name.
  ldapUrl              String?
  baseDn               String?
  bindDn               String?
  // The attribute map, defaulted to what a normal directory uses so an operator
  // only overrides what is genuinely different in theirs.
  usernameAttribute    String   @default("uid")
  emailAttribute       String   @default("mail")
  displayNameAttribute String   @default("cn")

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model system_prompt_variables {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  type        String   @default("system") // system, user, dynamic
  userId      Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model prompt_history {
  id          Int        @id @default(autoincrement())
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int
  prompt      String
  modifiedBy  Int?
  modifiedAt  DateTime   @default(now()) @db.Timestamptz(3)
  user        users?     @relation(fields: [modifiedBy], references: [id])

  @@index([workspaceId])
}

// Schema specific to mobile app <> Desktop app connection
model desktop_mobile_devices {
  id         Int      @id @default(autoincrement())
  deviceOs   String
  deviceName String
  token      String   @unique
  approved   Boolean  @default(false)
  userId     Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model workspace_parsed_files {
  id                 Int                @id @default(autoincrement())
  filename           String             @unique
  workspaceId        Int
  userId             Int?
  threadId           Int?
  metadata           String?
  tokenCountEstimate Int?               @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  workspace          workspaces         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               users?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread             workspace_threads? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model external_communication_connectors {
  id            Int      @id @default(autoincrement())
  type          String   @unique
  config        String   @default("{}")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model scheduled_jobs {
  id        Int                  @id @default(autoincrement())
  name      String
  prompt    String
  tools     String? // JSON array of tool identifiers (null = use all enabled agent skills)
  schedule  String // Cron expression
  enabled   Boolean              @default(true)
  lastRunAt DateTime?            @db.Timestamptz(3)
  nextRunAt DateTime?            @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @default(now()) @db.Timestamptz(3)
  runs      scheduled_job_runs[]
}

model scheduled_job_runs {
  id          Int            @id @default(autoincrement())
  jobId       Int
  status      String         @default("queued") // queued | running | completed | failed | timed_out — model always sets explicitly
  result      String? // JSON execution trace
  error       String?
  startedAt   DateTime       @default(now()) @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  readAt      DateTime?      @db.Timestamptz(3) // null = unread
  job         scheduled_jobs @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model memories {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  workspaceId Int?      @map("workspace_id")
  scope       String    @default("workspace")
  content     String
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  user      users?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace workspaces? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
  @@index([userId, scope])
}

model model_routers {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  description       String?
  fallback_provider String
  fallback_model    String
  cooldown_seconds  Int                  @default(30)
  created_by        Int?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  lastUpdatedAt     DateTime             @default(now()) @db.Timestamptz(3)
  rules             model_router_rules[]
}

model model_router_rules {
  id              Int           @id @default(autoincrement())
  router_id       Int
  enabled         Boolean       @default(true)
  priority        Int
  type            String        @default("calculated")
  title           String
  description     String?
  // For `calculated` rules: the boolean operator joining `conditions` — "AND"
  // (all must match) or "OR" (any must match). Null for `llm` rules.
  condition_logic String?
  // For `calculated` rules: JSON-stringified array of condition objects, each
  // shaped as { property: string, comparator: string, value: string } where
  // `property` ∈ VALID_PROPERTIES and `comparator` ∈ VALID_COMPARATORS (see
  // server/models/modelRouterRule.js). `value` is always stored as a string;
  // numeric comparators parse it at evaluation time. Null for `llm` rules.
  conditions      String?
  route_provider  String
  route_model     String
  created_by      Int?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  lastUpdatedAt   DateTime      @default(now()) @db.Timestamptz(3)
  router          model_routers @relation(fields: [router_id], references: [id], onDelete: Cascade)

  @@unique([router_id, title])
  @@index([router_id])
  @@index([router_id, enabled, priority])
}

// BEGIN P0-6 CORE SERVICES — keep block at end for Postgres migration rebase.
model jobs {
  id             String    @id
  type           String
  payload        String
  actor          String
  state          String    @default("pending")
  runAt          DateTime  @default(now()) @db.Timestamptz(3)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  idempotencyKey String
  traceId        String
  workerId       String?
  leaseUntil     DateTime? @db.Timestamptz(3)
  result         String?
  lastError      String?
  cancelReason   String?
  cancelledBy    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([type, idempotencyKey])
  @@index([state, runAt])
  @@index([workerId, leaseUntil])
}

model job_schedules {
  id        String    @id
  type      String
  cron      String
  timezone  String
  payload   String
  actor     String
  enabled   Boolean   @default(true)
  nextRunAt DateTime? @db.Timestamptz(3)
  claimedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
}

model job_dead_letters {
  id             Int      @id @default(autoincrement())
  jobId          String   @unique
  type           String
  payload        String
  actor          String
  attempts       Int
  error          String
  traceId        String
  deadLetteredAt DateTime @default(now()) @db.Timestamptz(3)
}

model event_outbox {
  id          String             @id
  type        String
  version     Int
  occurredAt  DateTime           @db.Timestamptz(3)
  actor       String
  resource    String
  traceId     String
  data        String
  sensitivity String
  payloadHash String
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  deliveries  event_deliveries[]

  @@index([occurredAt])
  @@index([type, occurredAt])
}

model event_deliveries {
  id             Int          @id @default(autoincrement())
  subscriberId   String
  eventId        String
  state          String       @default("pending")
  attempts       Int          @default(0)
  lastError      String?
  acknowledgedAt DateTime?    @db.Timestamptz(3)
  nextAttemptAt  DateTime?    @db.Timestamptz(3)
  claimedUntil   DateTime?    @db.Timestamptz(3)
  claimedBy      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  event          event_outbox @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, eventId])
  @@index([state])
  @@index([subscriberId, state])
}

// END P0-6 CORE SERVICES.

// ---- T-1 (P0-5): authorization policy store + canonical documents ----
// Signed-off design: docs/superpowers/design/p0-5-t1-schema-detail.md + migrations-draft/
// (architect 8b, live-verified on PG17). principal_id is TEXT: the single-user principal
// is 'single-user' (string namespace — never an integer sentinel in the user-id namespace).

model permissions {
  id               Int                @id @default(autoincrement())
  action           String             @unique // seam-02 verbatim vocabulary (also P0-4 scope strings)
  description      String             @default("")
  category         String             @default("")
  // #53: 'org' | 'workspace' | 'any' (CHECK in migration 102000). The engine
  // refuses an action asked against a resource shape its scope forbids.
  scope            String             @default("any")
  acl              document_acl[]
  role_permissions role_permissions[]

  @@index([category])
}

model roles {
  id                Int                     @id @default(autoincrement())
  name              String
  scope             String // 'org' | 'workspace'
  orgId             Int                     @default(1)
  isSystem          Boolean                 @default(false)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  role_permissions  role_permissions[]
  grants            principal_role_grants[]
  workspace_members workspace_users[]

  @@unique([orgId, scope, name])
}

model role_permissions {
  role_id       Int
  permission_id Int
  effect        String      @default("allow") // 'allow' | 'deny'; deny wins
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
}

model principal_role_grants {
  id             Int         @id @default(autoincrement())
  orgId          Int         @default(1)
  principal_type String // 'user' | 'group' | 'service' | 'embed' | 'system'
  principal_id   String
  role_id        Int
  workspace_id   Int? // null = org-wide grant
  granted_by     Int?
  granted_at     DateTime    @default(now()) @db.Timestamptz(3)
  expires_at     DateTime?   @db.Timestamptz(3)
  policy_version BigInt      @default(0)
  roles          roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  workspaces     workspaces? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  // NOTE: the migration creates this constraint as UNIQUE NULLS NOT DISTINCT (PG15+) —
  // org-wide grants have workspace_id NULL and plain UNIQUE lets them duplicate on re-runs.
  // Prisma cannot express the flag; no-drift verified via migrate diff in T-1 tests.
  @@unique([orgId, principal_type, principal_id, role_id, workspace_id])
  @@index([principal_type, principal_id, workspace_id])
  @@index([workspace_id, role_id])
}

model groups {
  id         Int             @id @default(autoincrement())
  orgId      Int             @default(1)
  name       String
  source     String          @default("local") // 'local' | 'lark' | 'oidc' | 'ldap'
  externalId String?
  members    group_members[]

  @@unique([orgId, name])
  // S4a (#113): one row per external department. The S4b reconciler matches on
  // `externalId`, and two rows claiming one department leave it with no correct
  // answer — picking either silently splits that department's membership.
  //
  // Plain unique, deliberately: Postgres treats NULLs as DISTINCT, so the local
  // groups (all NULL here) are unaffected, while two 'lark' rows on one id are
  // refused. `NULLS NOT DISTINCT` would fail at index creation on any database
  // that already holds two local groups.
  @@unique([orgId, source, externalId])
}

// S4b slice 2 (#134): what one directory sync run DID.
//
// Exists mainly for the run that did nothing. A REFUSED run (a scale guard fired)
// and a no-op run both write zero rows to every other table, so without this row
// they are the same event — and the entire point of refusing a misconfigured sync
// is that somebody notices. `status` + `refusedReason` are what make them
// distinguishable; both are pinned by CHECK constraints in the migration, because
// this table is read to decide whether a sync is overdue and a typo'd status would
// hide a refusal from every query looking for one.
//
// Written LAST, in its own transaction, after every write in the plan succeeded
// (R5). A crash mid-apply then leaves a partially-applied sync that the next run
// corrects by re-deriving from current state, rather than a rolled-back one that
// discarded work already proven correct.
model directory_sync_checkpoints {
  id                 BigInt   @id @default(autoincrement())
  orgId              Int      @default(1)
  provider           String
  status             String // 'completed' | 'refused' | 'failed'
  refusedReason      String?
  usersCreated       Int      @default(0)
  usersDeactivated   Int      @default(0)
  groupsCreated      Int      @default(0)
  membershipsAdded   Int      @default(0)
  membershipsRemoved Int      @default(0)
  startedAt          DateTime @db.Timestamptz(3)
  finishedAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([orgId, provider, finishedAt(sort: Desc)])
}

model group_members {
  group_id Int
  user_id  Int
  groups   groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([group_id, user_id])
  @@index([user_id])
}

model documents {
  id               Int                   @id @default(autoincrement())
  orgId            Int                   @default(1)
  owner_id         Int?
  filename         String
  dedupe_key       String                @unique // = docpath ('orphan:<docId>' for legacy empty paths); runtime resolves canonical-by-docpath on every ingest
  metadata         String                @default("{}")
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  workspaces       workspace_documents[]
  acl              document_acl[]
  visibility       document_visibility?
  legacy_docid_map legacy_docid_map[]

  @@index([orgId])
}

// WRITE THROUGH `policyRepository` ONLY — `grantDocumentAcl` / `revokeDocumentAcl`.
//
// Those bump `policy_versions` inside the same transaction, and `FilterCache` keys on that
// version. A direct `prisma.document_acl.create/update/delete` changes the row without
// moving the clock, so every cached filter in the process keeps serving pre-change policy
// and cannot tell that it is stale — a revoked grant stays effective for the cache TTL,
// silently. Asserted in pinnedContextAcl.test.js ("a raw ACL write leaves caches stale").
model document_acl {
  id             Int         @id @default(autoincrement())
  orgId          Int         @default(1)
  document_id    Int
  principal_type String // 'user' | 'group' | 'workspace' | 'embed'
  principal_id   String
  action         String
  effect         String      @default("allow")
  source         String      @default("manual") // 'manual' | 'connector' | 'inherited_workspace' | 'document_set'
  granted_at     DateTime    @default(now()) @db.Timestamptz(3)
  policy_version BigInt      @default(0)
  documents      documents   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  permissions    permissions @relation(fields: [action], references: [action])

  @@unique([document_id, principal_type, principal_id, action])
  @@index([principal_type, principal_id, action])
  @@index([document_id])
  @@index([orgId, source])
}

model document_visibility {
  document_id Int       @id
  hidden      Boolean   @default(false)
  hidden_by   Int?
  hidden_at   DateTime? @db.Timestamptz(3)
  reason      String?
  documents   documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
}

model policy_versions {
  version     BigInt   @id @default(autoincrement())
  changed_at  DateTime @default(now()) @db.Timestamptz(3)
  change_type String
  scope_key   String // 'org:1' | 'workspace:7' | 'document:<id>'
  actor_id    Int?

  @@index([scope_key])
}

model legacy_docid_map {
  id            Int       @id @default(autoincrement())
  legacy_doc_id String    @unique
  canonical_id  Int
  mapped_at     DateTime  @default(now()) @db.Timestamptz(3)
  documents     documents @relation(fields: [canonical_id], references: [id], onDelete: Cascade)
}

// END T-1 P0-5 AUTHORIZATION SCHEMA.

// T-7 (#31): revocations outlive the grants they describe — revokeGrant deletes
// the row, so a column on principal_role_grants would die with the fact it
// records. See migration 20260902021000.
model grant_revocations {
  id              Int       @id @default(autoincrement())
  orgId           Int       @default(1)
  principal_type  String
  principal_id    String
  role_id         Int?
  role_name       String
  workspace_id    Int?
  revoked_by_type String
  revoked_by_id   String
  revoked_at      DateTime  @default(now()) @db.Timestamptz(3)
  policy_version  BigInt    @default(0)
  reason          String?

  @@index([principal_type, principal_id, revoked_at])
  @@index([workspace_id, revoked_at])
}
