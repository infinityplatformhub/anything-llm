# E2E stack env — deliberately UNCONFIGURED so the onboarding wizard runs
# (boot's legacy markOnboarded patch treats LLM_PROVIDER/AUTH_TOKEN env as
# "already onboarded" and skips the wizard entirely). The test configures the
# Generic OpenAI provider + embedder through the wizard UI, pointed at mock-llm.
DISABLE_TELEMETRY=true
# PR-3 boot check (R8): API key HMAC pepper, fail-closed when absent.
API_KEY_PEPPER=e2e-stack-pepper-0123456789abcdef0123456789abcdef
