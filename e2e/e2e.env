# E2E stack env — generic-openai LLM + embedder pointing at the mock provider.
# NO AUTH_TOKEN/JWT_SECRET: the instance must boot unconfigured so onboarding
# runs and creates the multi-user admin.
LLM_PROVIDER=generic-openai
GENERIC_OPEN_AI_BASE_PATH=http://mock-llm:8080/v1
GENERIC_OPEN_AI_MODEL_PREF=mock-llm
GENERIC_OPEN_AI_API_KEY=e2e-mock-key
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=4096
EMBEDDING_ENGINE=generic-openai
EMBEDDING_BASE_PATH=http://mock-llm:8080/v1
EMBEDDING_MODEL_PREF=mock-embed
GENERIC_OPEN_AI_EMBEDDING_API_KEY=e2e-mock-key
DISABLE_TELEMETRY=true
